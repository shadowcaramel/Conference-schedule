{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conference-schedule.local/schema/organization.schema.json",
  "title": "Organizations",
  "type": "array",
  "items": { "$ref": "#/$defs/organization" },
  "$defs": {
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/id"
        },
        "name": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            {
              "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/bilingual"
            }
          ]
        },
        "url": { "type": "string" },
        "logo": { "type": "string" }
      }
    }
  }
}
