{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conference-schedule.local/schema/contribution.schema.json",
  "title": "Contributions",
  "type": "array",
  "items": { "$ref": "#/$defs/contribution" },
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["person_id", "affiliation_ids", "presenting"],
      "properties": {
        "person_id": {
          "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/id"
        },
        "affiliation_ids": {
          "type": "array",
          "items": {
            "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/id"
          }
        },
        "presenting": { "type": "boolean" }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format", "title", "authors", "status"],
      "properties": {
        "id": {
          "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/id"
        },
        "format": {
          "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/contributionFormat"
        },
        "track_id": {
          "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/id"
        },
        "session_id": {
          "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/id"
        },
        "order": { "type": "integer", "minimum": 1 },
        "number": { "type": "string", "minLength": 1 },
        "title": {
          "anyOf": [
            { "type": "string" },
            {
              "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/bilingual"
            }
          ]
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/author" }
        },
        "duration_min": { "type": "integer", "minimum": 1 },
        "start": {
          "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/time"
        },
        "status": {
          "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/contributionStatus"
        },
        "topic_id": {
          "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/id"
        },
        "note": {
          "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/bilingual"
        },
        "sponsor_id": {
          "$ref": "https://conference-schedule.local/schema/common.schema.json#/$defs/id"
        },
        "board": { "type": "string" }
      }
    }
  }
}
